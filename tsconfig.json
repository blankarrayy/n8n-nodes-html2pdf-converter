{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2020",
    "lib": ["es2020"],
    "removeComments": true,
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "./dist/"
  },
  "include": [
    "nodes/**/*",
    "utils/**/*",
    "test/**/*",
    "index.ts"
  ]
}
